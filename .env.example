# ── Courier · HackMTY 2026 ─────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values you want:
#   cp .env.example .env.local

# Google Maps API key — optional but recommended.
# Enables traffic-aware Directions routing (simulated 08:00 departure) and the
# live Places catalog model. Without it the app falls back to the free OSRM
# public server and the bundled mock order dataset.
GOOGLE_MAPS_API_KEY=

# Runtime toggles (all optional).
# Compete mode: when set to "true", each order is claimed exclusively by one
# agent ("⚔️ compete"). Unset/"false" runs shared "compare" mode — both agents
# evaluate every order. Also toggleable in-app on the start screen.
# NEXT_PUBLIC_COMPETE_MODE=true